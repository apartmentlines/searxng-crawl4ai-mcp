# SearXNG Configuration for MCP Server
use_default_settings:
  engines:
    keep_only:
      - google
      # - bing
      # - yahoo
      # - startpage
      # - qwant
      # - mojeek
      # - duckduckgo
      # - brave

general:
  debug: false
  instance_name: "SearXNG MCP"
  donation_url: false
  contact_url: false
  enable_stats: false

search:
  safe_search: 0
  autocomplete: ""
  default_lang: "en"
  max_request_timeout: 10.0
  formats:
    - html
    - json

server:
  port: 8080
  bind_address: "0.0.0.0"
  secret_key: "${SEARXNG_SECRET}"
  base_url: "http://localhost:8081/"
  image_proxy: true
  http_protocol_version: "1.1"
  method: "POST"
  limiter: false

ui:
  static_use_hash: false
  default_locale: "en"
  query_in_title: true
  infinite_scroll: false
  center_alignment: false
  cache_url: "https://web.archive.org/web/"
  default_theme: simple
  theme_args:
    simple_style: auto

# Outgoing requests
outgoing:
  request_timeout: 6.0
  max_request_timeout: 15.0
  pool_connections: 20
  pool_maxsize: 10
  enable_http2: true
  retries: 0
  proxies:
    all://:
      - "http://${SEARXNG_PROXY_USER}:${SEARXNG_PROXY_PASSWORD_URLENCODED}@us.decodo.com:10000"
  extra_proxy_timeout: 10

engines:
  # Preferred general web engines for private use
  - name: google
    engine: google
    shortcut: go
    use_mobile_ui: false
    timeout: 8.0
    weight: 1.0
    disabled: false

  # - name: bing
  #   engine: bing
  #   shortcut: bi
